# Copy to .env.local for local development. Never commit real keys.

# Canonical site URL (metadata, sitemap and the inquiry origin check).
NEXT_PUBLIC_SITE_URL=https://clyneratech.com

# Inquiry delivery: "emailjs" in production. "log" is for local development and E2E only.
INQUIRY_DELIVERY=log

# EmailJS (server side only; none of these reach the browser). IDs are not secret; keys are.
EMAILJS_SERVICE_ID=service_k3yhmpd
EMAILJS_TEMPLATE_ID=template_lcsit4b
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
# Optional: a separate template for careers sign-ups.
EMAILJS_TEMPLATE_ID_CANDIDATE=
